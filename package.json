{
  "name": "dsh-auto-liangwengu-switch",
  "version": "1.0.0",
  "private": true,
  "description": "自动梁文谷执行开关 — DSH 峰谷执行开关：高峰时段发送的任务自动挂载为自动化任务，在最近的谷时于当前会话内执行。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsjeee/dsh-auto-liangwengu-switch.git"
  },
  "homepage": "https://github.com/tsjeee/dsh-auto-liangwengu-switch",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "interception.js",
    "time.js",
    "holidays.js",
    "holiday-sync.js",
    "holiday-data.json",
    "calendar-payload.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "icon.svg"
  ],
  "scripts": {
    "test": "node test/test.mjs && node test/client-sync.mjs && node test/client-smoke.mjs && node test/bundle-check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
